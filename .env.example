# ==============================================================================
# Virtual Classroom Platform - Unified Root Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' at the repository root:
#    cp .env.example .env
# 2. Configure credentials appropriate for your target environment.
# 3. NEVER commit real credentials, passwords, or cryptographic secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Network Configuration
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=virtual-classroom
FRONTEND_PORT=3000
BACKEND_PORT=8080

# ------------------------------------------------------------------------------
# 2. Database Configuration (Supabase PostgreSQL / External PostgreSQL)
# Note: In production and standard development, connect to your Supabase project.
# Format: jdbc:postgresql://<db-host>:<port>/<database-name>?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_USERNAME=postgres.your_supabase_project_ref
DATABASE_PASSWORD=your_secure_supabase_database_password_here

# ------------------------------------------------------------------------------
# 3. Optional Local PostgreSQL Container (Profile: local-db)
# Used only when running offline without Supabase: docker compose --profile local-db up
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_DB=virtual_classroom
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_postgres_password_here

# ------------------------------------------------------------------------------
# 4. Spring Boot Backend Runtime Configuration
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
DB_POOL_MAX=10
DB_POOL_MIN=2

# ------------------------------------------------------------------------------
# 5. JWT Authentication & Security Configuration (MANDATORY & SECRET)
# Generate a cryptographically secure 256-bit secret via: openssl rand -base64 32
# Startup fails immediately in production if JWT_SECRET is unset or under 32 bytes.
# ------------------------------------------------------------------------------
JWT_SECRET=your_secure_base64_encoded_256_bit_secret_here_min_32_bytes
JWT_EXPIRATION_MS=86400000

# Cookie Security (Must be 'true' for production HTTPS deployments)
COOKIE_SECURE=false

# Allowed Cross-Origin Resource Sharing (CORS) Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Storage Provider Configuration (Supabase Storage / Local Fallback)
# In production, set STORAGE_PROVIDER=supabase and provide service role credentials.
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Backend-only Service Role Secret: NEVER expose to frontend clients or browsers
SUPABASE_SERVICE_ROLE_KEY=your_backend_only_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=academic-assets
STORAGE_LOCAL_DIR=./uploads

# ------------------------------------------------------------------------------
# 7. Frontend Client Build-time Configuration
# Note: VITE_* variables are embedded into client-side JS bundles during build.
# NEVER place database passwords, JWT secrets, or Supabase service keys here.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="Virtual Classroom"
VITE_APP_DESCRIPTION="Enterprise Modern LMS & Virtual Classroom Platform"
# Security gate: Demo credentials bar is enabled ONLY when explicitly 'true' and in dev mode
VITE_ENABLE_DEMO_CREDENTIALS=false
