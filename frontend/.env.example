# ==============================================================================
# Virtual Classroom Platform - Frontend Environment Template
# ==============================================================================
# Copy to frontend/.env for local standalone Vite development
# ==============================================================================

# API Base URL consumed by Axios client (default: http://localhost:8080/api/v1)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME="Virtual Classroom"
VITE_APP_DESCRIPTION="Enterprise Modern LMS & Virtual Classroom Platform"

# Security: Enable demo credentials bar ONLY in local development
# In production builds, this is automatically stripped and disabled
VITE_ENABLE_DEMO_CREDENTIALS=false
