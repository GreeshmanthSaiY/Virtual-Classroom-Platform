# Virtual Classroom Platform - Backend Environment Template
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=jdbc:postgresql://localhost:5432/virtual_classroom?sslmode=prefer
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_database_password_here

# JWT Security (Generate with: openssl rand -base64 32)
JWT_SECRET=your_secure_base64_encoded_256_bit_secret_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cookie Security (Must be true in production HTTPS)
COOKIE_SECURE=false

# Supabase Storage Configuration (Required in production)
STORAGE_PROVIDER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_backend_only_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=academic-assets
