# Virtual Classroom Platform - Backend Environment Template
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=jdbc:postgresql://localhost:5432/virtual_classroom?sslmode=prefer
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here

# JWT Security
JWT_SECRET=c2VjdXJlLXZpcnR1YWwtY2xhc3Nyb29tLXBsYXRmb3JtLWtleS0yMDI2LWVudGVycHJpc2Utc2VjdXJl
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase Storage Configuration (Optional cloud storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_STORAGE_BUCKET=classroom-materials
