# ==============================================================================
# Virtual Classroom Platform - Backend Environment Template
# ==============================================================================
# Copy to backend/.env for local standalone development without Docker
# ==============================================================================

SERVER_PORT=8080
PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/virtual_classroom?sslmode=prefer
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_database_password_here

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=2

# JWT Security (Generate with: openssl rand -base64 32)
JWT_SECRET=your_secure_base64_encoded_256_bit_secret_here_min_32_bytes
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cookie Security (Must be true in production HTTPS)
COOKIE_SECURE=false

# Storage Provider Configuration (Supabase Storage / Local File Storage)
STORAGE_PROVIDER=local
SUPABASE_URL=https://your-project-ref.supabase.co
# Backend-only Service Role Secret: NEVER expose to frontend clients or browsers
SUPABASE_SERVICE_ROLE_KEY=your_backend_only_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=academic-assets
STORAGE_LOCAL_DIR=./uploads
